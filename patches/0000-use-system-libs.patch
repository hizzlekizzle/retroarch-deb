 ifneq ($(HAVE_BUILTINSPIRV_CROSS), 0)
    DEFINES += -DHAVE_BUILTINSPIRV_CROSS
-   INCLUDE_DIRS += -I$(DEPS_DIR)/SPIRV-Cross
-   OBJ += $(DEPS_DIR)/SPIRV-Cross/spirv_cross.o
