-   OBJ += $(DEPS_DIR)/SPIRV-Cross/spirv_cross_parsed_ir.o
-   OBJ += $(DEPS_DIR)/SPIRV-Cross/spirv_cross_c.o
+   INCLUDE_DIRS += -I/usr/include/spirv_cross
+   LIBS += -lspirv-cross-cpp -lspirv-cross-msl -lspirv-cross-glsl \
+			-lspirv-cross-c-shared -lspirv-cross-core
    # The C API translation unit compiles its backend wrappers only
