Description: Remove compiled-in datestamps making builds non-reproducible
Author: Peter J. Mello <admin@petermello.net>
Origin: other
Forwarded: no
Last-Update: 2024-06-04

--- a/menu/menu_displaylist.c
+++ b/menu/menu_displaylist.c
@@ -16,6 +16,7 @@
  *  If not, see <http://www.gnu.org/licenses/>.
  */

+#include <stdlib.h>
 #include <stddef.h>
 
 #include <compat/strl.h>
@@ -1833,13 +1834,21 @@ static unsigned menu_displaylist_parse_s
 #endif
 
    /* Build Date */
+   struct tm *build_time;
+   time_t source_date_epoch;
+   char *source_date_epoch_str;
+   if ((source_date_epoch_str = getenv("SOURCE_DATE_EPOCH")) == NULL ||
+       (source_date_epoch = (time_t)strtoll(source_date_epoch_str, NULL, 10)) <= 0)
+           build_time = gmtime(&source_date_epoch);
+   char date_str[12];
+   strftime(date_str, sizeof(date_str), "%Y-%m-%d", build_time);
    _len            = strlcpy(entry,
          msg_hash_to_str(MENU_ENUM_LABEL_VALUE_SYSTEM_INFO_BUILD_DATE),
          sizeof(entry));
    entry[  _len]   = ':';
    entry[++_len]   = ' ';
    entry[++_len]   = '\0';
-   strlcpy(entry + _len, __DATE__, sizeof(entry) - _len);
+   strlcpy(entry + _len, date_str, sizeof(entry) - _len);
    if (menu_entries_append(list, entry, "",
          MENU_ENUM_LABEL_SYSTEM_INFO_ENTRY, MENU_SETTINGS_CORE_INFO_NONE,
          0, 0, NULL))
