prefix=/usr
exec_prefix=${prefix}
bindir=${prefix}/lib/qt6/bin
libexecdir=${prefix}/lib/qt6/libexec
libdir=${prefix}/lib/@DEB_HOST_MULTIARCH@
includedir=${prefix}/include/@DEB_HOST_MULTIARCH@/qt6
mkspecsdir=${prefix}/lib/@DEB_HOST_MULTIARCH@/qt6/mkspecs

Name: Qt6 Platform
Description: Qt Platform module
Version: 6.2.4
Cflags: -I${mkspecsdir}/linux-g++ -I${includedir}
