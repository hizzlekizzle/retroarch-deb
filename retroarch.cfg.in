## Configuration file for RetroArch

# If set to a directory, the content history playlist will be saved
# to this directory.
content_history_directory = "~/.local/state/retroarch/plists"

# Automatically saves a savestate at the end of RetroArch's lifetime.
# The path is $SRAM_PATH.auto.
# RetroArch will automatically load any savestate with this path on startup if savestate_auto_load is set.
# savestate_auto_save = "false"
# savestate_auto_load = "true"

# Set logging level for libretro cores (GET_LOG_INTERFACE); this setting
# overrides per-core log level settings. To capture DEBUG level logs, verbose
# mode must be activated at runtime (--verbose). Valid values:
#   0 = DEBUG, 1 = INFO, 2 = WARNING, 3 = ERROR.
# libretro_log_level = "1"

# Enable or disable verbosity level of frontend.
# log_verbosity = "false"

# Automatically add every content file loaded in RetroArch to the history list.
# history_list_enable = "true"

# Enable performance counters
# perfcnt_enable = "false"

# Path to core options configuration file, which exposes core-specific options
# and will be written to by RetroArch. If unset, a default path will be used.
core_options_path = ""

# Path to content history file. RetroArch keeps track of all content loaded in
# the menu and directly from the command line for convenient quick loading.
# If unset, a default path will be used.
content_history_directory = "~/.local/state/retroarch/plists"
content_history_path = "~/.local/state/retroarch/plists/content_history.lpl"

# Path to music content history file (optional). RetroArch keeps track of all
# audio content loaded in the menu and directly from the command line for
# convenient quick loading. If unset, a default path will be used.
content_music_history_directory = "~/.local/state/retroarch/plists"
content_music_history_path = "~/.local/state/retroarch/plists/content_music_history.lpl"

# Path to image content history file (optional). RetroArch keeps track of all
# image content loaded in the menu and directly from the command line for
# convenient quick loading. If unset, a default path will be used.
content_image_history_directory = "~/.local/state/retroarch/plists"
content_image_history_path = "~/.local/state/retroarch/plists/content_image_history.lpl"

# Path to video content history file (optional). RetroArch keeps track of all
# video content loaded in the menu and directly from the command line for
# convenient quick loading. If unset, a default path will be used.
content_video_history_path = "~/.local/share/retroarch/plists/content_video_history.lpl"

# Number of entries that will be kept in content history file.
# content_history_size = "200"

# Content directory, interacts with RETRO_ENVIRONMENT_GET_CONTENT_DIRECTORY.
# Usually set by developers bundling libretro/RetroArch apps to locate assets.
# content_directory = ""

# Sets start directory for menu config browser.
rgui_config_directory = "~/.config/retroarch"

# Show startup screen in menu; automatically set to false after first view.
# This is only updated here if config_save_on_exit is set to true.
# rgui_show_start_screen = "true"

# Write active configuration to disk before each exit. Useful for customizing
# the menu on-the-fly. Existing #include's and comments will be lost.
# config_save_on_exit = "true"

# Show hidden files and folders in directory listings.
# show_hidden_files = "false"

#### Driver

# Input driver; certain video drivers may override this setting.
input_driver = "x"

# Joypad driver, one of:
#   "udev", "linuxraw", "paraport", "sdl2", "hid" or "dinput"
input_joypad_driver = "udev"

# Video driver, one of: "gl", "xvideo", "sdl" or "d3d"
video_driver = "gl"

# Context implementation, one of: "glx", "x-egl", "kms-egl", "sdl-gl" or "wgl".
# If unset, uses first suitable driver from the order above.
video_context_driver = "glx"

# Audio driver, one of:
#   "alsa", "pulse", "jack", "openal", "pipewire", "sdl" or "xaudio"
audio_driver = "pulse"

# Audio resampler backend, defaults to "sinc".
audio_resampler = "sinc"

# Camera driver.
camera_driver = "video4linux2"

# Location driver.
location_driver = "null"

# Menu driver, one of: "rgui", "xmb", "glui" or "ozone".
menu_driver = "rgui"

# Video recording driver.
record_driver = "ffmpeg"

#### Video

# Suspends the screensaver when set to "true"; is not necessarily honored by
# the video driver.
# suspend_screensaver_enable = "true"

# Display framerate overlay during normal operation.
# fps_show = "false"

# Display memory usage overlay during normal operation.
# memory_show = "false"

# Also show total number of frames rendered; only available when fps_show is
# enabled.
# framecount_show = "false"

# Preferred primary monitor. 0 (default) means no preference, positive integers
# (1 and up) set preference for XRandR/Wayland 1-indexed output.
# video_monitor_index = "0"

# Start in fullscreen mode; can be changed at runtime.
# video_fullscreen = "false"

# If fullscreen, prefer using windowed fullscreen mode (show titlebar with
# compositor control decorations).
# video_windowed_fullscreen = "true"

# Fullscreen resolution; 0 indicates to use the current desktop resolution.
# video_fullscreen_x = "0"
# video_fullscreen_y = "0"

# CRT (tube-style) video output refresh rate; used to calculate a suitable
# audio input rate.
# crt_video_refresh_rate = "59.94"

# Digital flat panel video refresh rate; used to calculate a suitable audio
# input rate.
# video_refresh_rate = "59.94"

# Forcibly disable sRGB FBO support.
# video_force_srgb_disable = "false"

# Let aspect ratio be decided by libretro implementation if video_aspect_ratio
# is not set below; if set to false, 1:1 PAR will always be assumed.
# video_aspect_ratio_auto = "false"

# Set fixed floating point value for video aspect ratio (width / height). If
# unset, aspect ratio calculation method is defined by video_aspect_ratio_auto.
# video_aspect_ratio = ""

# Windowed x/y resolution scales.
# X resolution: base_size × xscale × aspect_ratio.
# Y resolution: base_size × yscale.
# video_scale = "3.0"

# Main window opacity (100 = completely opaque).
# video_window_opacity = "100"

# Show standard window decorations (border, titlebar, etc.).
# video_window_show_decorations = "true"

# Video vsync.
# video_vsync = "true"

# Vsync swap interval:
#   1 = normal, 2 = doubled frames, 3 = tripled frames, etc.
# video_swap_interval = "1"

# Maximum number of swapchain images:
#   1 = single buffer, 2 = double buffered, 3 = triple buffered, etc.
# video_max_swapchain_images = "3"

# Hard CPU/GPU synchronization; can reduce latency but has performance cost.
# video_hard_sync = "false"

# Maximum number of frames CPU can run ahead of GPU when using video_hard_sync.
# Valid values: 0 – 3.
# video_hard_sync_frames = "0"

# Time delay in ms between VSync acquisition and libretro core initialization.
# Can reduce latency but increases risk of output stuttering. Accepts: 0 – 15.
# video_frame_delay = "0"

# Insert a empty frame between output frames; useful for 120Hz monitors that
# want to play 60Hz material with eliminated ghosting. video_refresh_rate
# should still be configured as if it is a 60Hz monitor (refresh rate / 2).
# video_black_frame_insertion = "false"

# Use threaded video driver; this might improve performance at a possible cost
# of latency and more video stuttering.
# video_threaded = "false"

# Use shared context for hardware-rendered libretro cores; avoids having to
# assume hardware state changes between frames.
# video_shared_context = "false"

# Smooth output using bi-linear filtering; should be disabled if using pixel
# shaders.
# video_smooth = "true"

# Force rendering area to stay equal to content aspect ratio, or as defined in
# video_aspect_ratio.
# video_force_aspect = "true"

# Only scale video by integer multiples; the base size depends on the
# system-reported geometry/aspect ratio. If video_force_aspect is unset, X/Y
# will be integer scaled independently.
# video_scale_integer = "false"

# Index of the aspect ratio selection in the menu:
#   20 = Config, 21 = 1:1 PAR, 22 = Core Provided, 23 = Custom Aspect Ratio
# aspect_ratio_index = "20"

# Force cropping of overscanned frames; exact behavior is
# implementation-specific.
# video_crop_overscan = "true"

# Path to shader, can be either Cg, GLSL or their presets:
#   CGP (Cg preset) or GLSLP (GLSL preset)
# video_shader = "/path/to/shader.{cg,cgp,glsl,glslp}"

# Load video_shader on startup, other shaders can still be loaded at runtime.
# video_shader_enable = "false"

# CPU-based video filter; path to a dynamic library.
# video_filter = ""

# Path to a font used for message rendering; must be defined to enable fonts.
# NOTE: The *full* canonical path of the font is required.
# video_font_path = ""

# Size of the rendered message font, in pts.
# video_font_size = "32"

# Enable on-screen display messages.
# video_font_enable = "true"

# Offset for message placement on screen, valid values:
#   0.0 – 1.0 for both x and y axes; [0.0, 0.0] = lower-left corner of screen.
# video_message_pos_x = "0.05"
# video_message_pos_y = "0.05"

# Message font color, as an RRGGBB-formatted hexadecimal value.
# (red = "ff0000", green = "00ff00", blue = "0000ff", white = "ffffff")
# video_message_color = "ffffff"

# On-screen display message background color.
# Valid values for Red/Green/Blue: 0 – 255; Opacity: 0.0 – 1.0.
# video_message_bgcolor_enable = "false"
# video_message_bgcolor_red = "0"
# video_message_bgcolor_green = "0"
# video_message_bgcolor_blue = "0"
# video_message_bgcolor_opacity = "1.0"

# Allow libretro cores to set rotation modes; useful for vertically-oriented
# content where user manually rotates the display as-needed.
# video_allow_rotate = "true"

# Forcefully enable a specific video orientation; the value is added to the
# available rotations the libretro core naturally provides (see
# video_allow_rotate). The angle is <value> × 90°, counter-clockwise.
# video_rotation = "0"

# Force a specific screen orientation from the operating system; the angle is:
#   <value> × 90°, counter-clockwise.
# screen_orientation = "0"

# HDR settings.
# video_hdr_enable           = "false"
# video_hdr_max_nits         = "1000.0f"
# video_hdr_paper_white_nits = "200.0f"
# video_hdr_contrast         = "1.0f"
# video_hdr_expand_gamut     = "true"

#### Audio

# Enable audio.
# audio_enable = "true"

# Enable menu audio sounds.
# audio_enable_menu = "false"
# audio_enable_menu_ok = "false"
# audio_enable_menu_cancel = "false"
# audio_enable_menu_notice = "false"
# audio_enable_menu_bgm = "false"

# Mute audio.
# audio_mute_enable = "false"

# Mute audio mixer volume globally.
# audio_mixer_mute_enable = "false"

# Audio output samplerate.
# audio_out_rate = "48000"

# Override the default audio device; this setting is driver-dependant.
# (e.g. ALSA wants a PCM device, Jack wants port names such as
# system:playback1,system:playback_2, etc.)
# audio_device = ""

# Audio DSP preprocessor plugin; must be a path to a dynamic library.
# audio_dsp_plugin = ""

# Sync (block) on audio. (Recommended)
# audio_sync = "true"

# Desired audio latency, in milliseconds; can be ignored by the active audio
# driver if it is unable to provide the requested value.
# audio_latency = "64"

# Enable audio rate control.
# audio_rate_control = "true"

# Audio rate control delta, or how much the input rate can be adjusted
# dynamically; calculated as: in_rate × (1.0 ± audio_rate_control_delta).
# audio_rate_control_delta = "0.005"

# Maximum audio timing skew, or the maximum change in input rate; calculated
# as: in_rate × (1.0 ± max_timing_skew).
# audio_max_timing_skew = "0.05"

# Startup audio volume, expressed in dB where 0 dB is normal volume with no
# gain (managed at runtime with input_volume_up/input_volume_down) applied.
# audio_volume = "0.0"

# Audio mixer volume, expressed in dB where 0 dB is normal volume with no gain
# applied.
# audio_mixer_volume = "0.0"

#### Microphone

# Enable microphone support.
# microphone_enable = "true"

# Desired microphone latency, in milliseconds; can be ignored by the active
# audio driver if it is unable to provide the requested value.
# microphone_latency = "64"

#### Overlay

# Display the input overlay.
# input_overlay_enable = "true"

# Show the overlay behind the menu instead of superimposing it.
# input_overlay_behind_menu = "false"

# Prevent the current overlay from appearing inside the menu.
# input_overlay_hide_in_menu = "true"

# Path to input overlay.
# input_overlay = ""

# Opacity of all of the UI elements of the overlay.
# input_overlay_opacity = "1.0"

# Input overlay UI element scaling.
# input_overlay_scale = "1.0"

# Center position for all UI elements of the input overlay.
# input_overlay_center_x = "0.5"
# input_overlay_center_y = "0.5"

#### Input

# Path to input remapping file.
# input_remapping_path = ""

# Input bind timer timeout, in seconds; the time alloted for each bind event
# before skipping to the next. Default: 5, minimum: 1.
input_bind_timeout = "3"

# Override input binds with the remappings set for the current core.
# input_remap_binds_enable = "true"

# Maximum number of players.
# input_max_users = "16"

# Keyboard layout for input driver, if applicable (only supported by udev and
# evdev, currently). Syntax is either layout-only ("no"), or a layout and
# variant separated by a colon ("no:nodeadkeys").
# input_keyboard_layout = ""

# Input analog axis threshold; valid values: 0.0 – 1.0.
# input_axis_threshold = "0.5"

# input_analog_deadzone = "0.0"

# input_analog_sensitivity = "1.0"

# Enable input auto-detection; attempt joypad configuration a la plug-and-play.
# input_autodetect_enable = "true"

# Prefer showing input descriptors set by the active core over the defaults.
# input_descriptor_label_show = "true"

# Hide input descriptors that are not set by the active core.
# input_descriptor_hide_unbound = "false"

# Define when input polling is performed.
#   0 = Early  - polling performed before call to retro_run.
#   1 = Normal - polling performed when retro_input_poll is requested.
#   2 = Late   - polling performed on first call to retro_input_state.
# Selecting 0 or 2 can sometimes reduce latency, depending on your system.
# When netplay is enabled, default behavior (1) is always used.
# input_poll_type_behavior = "1"

# Assigns libretro devices to players, devices are indentified by number;
# typically saved from the menu. Device IDs are listed in libretro.h. These
# settings are overridden by explicit command-line arguments which referemce
# input devices.
#   0   = None
#   1   = Joypad (RetroPad)
#   2   = Mouse
#   3   = Keyboard
#   4   = Generic lightgun
#   5   = Joypad w/ analog (RetroPad + analog sticks)
#   257 = Multitap (SNES-specific)
#   260 = Super Scope (SNES-specific)
#   516 = Justifier (SNES-specific)
#   772 = Justifiers (SNES-specific)
# input_libretro_device_p1 = ""
# input_libretro_device_p2 = ""
# input_libretro_device_p3 = ""
# input_libretro_device_p4 = ""
# input_libretro_device_p5 = ""
# input_libretro_device_p6 = ""
# input_libretro_device_p7 = ""
# input_libretro_device_p8 = ""

# Keyboard inputs; recognizes letters (a–z) and the special key names
# ("kp_" = Numpad keys):
#   left, right, up, down, enter, kp_enter, tab, insert, del, end, home,
#   rshift, shift, ctrl, alt, space, escape, add, subtract, kp_plus, kp_minus,
#   f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, num0, num1, num2, num3,
#   num4, num5, num6, num7, num8, num9, pageup, pagedown, keypad0, keypad1,
#   keypad2, keypad3, keypad4, keypad5, keypad6, keypad7, keypad8, keypad9,
#   period, capslock, numlock, backspace, multiply, divide, print_screen,
#   scroll_lock, tilde, backquote, pause, quote, comma, minus, slash,
#   semicolon, equals, leftbracket, backslash, rightbracket, kp_period,
#   kp_equals, rctrl and ralt.
# All assignments will obey the "nul" bind to disable them.
# input_player1_a = "x"
# input_player1_b = "z"
# input_player1_y = "a"
# input_player1_x = "s"
# input_player1_start = "enter"
# input_player1_select = "rshift"
# input_player1_l = "q"
# input_player1_r = "w"
# input_player1_left = "left"
# input_player1_right = "right"
# input_player1_up = "up"
# input_player1_down = "down"
# input_player1_l2 = ""
# input_player1_r2 = ""
# input_player1_l3 = ""
# input_player1_r3 = ""

# Dual analog sticks (DualShock-esque), bound as usual; if a real analog axis
# is bound, it can be read as such. +X-axis is right, and +Y-axis is down.
# input_player1_l_x_plus = ""
# input_player1_l_x_minus = ""
# input_player1_l_y_plus = ""
# input_player1_l_y_minus = ""
# input_player1_r_x_plus = ""
# input_player1_r_x_minus = ""
# input_player1_r_y_plus = ""
# input_player1_r_y_minus = ""

# These settings override which joypads are assigned to players 1–8; they are
# 0-indexed.
# input_player1_joypad_index = "0"
# input_player2_joypad_index = "1"
# input_player3_joypad_index = "2"
# input_player4_joypad_index = "3"
# input_player5_joypad_index = "4"
# input_player6_joypad_index = "5"
# input_player7_joypad_index = "6"
# input_player8_joypad_index = "7"

# Input device button assignments, use the RetroArch configuration menu to
# discover the default mappings. Joypad hats are "hnxx", where n is the hat
# number and xx represents the direction, e.g. "h0up".
# input_player1_a_btn = ""
# input_player1_b_btn = ""
# input_player1_y_btn = ""
# input_player1_x_btn = ""
# input_player1_start_btn = ""
# input_player1_select_btn = ""
# input_player1_l_btn = ""
# input_player1_r_btn = ""
# input_player1_left_btn = ""
# input_player1_right_btn = ""
# input_player1_up_btn = ""
# input_player1_down_btn = ""
# input_player1_l2_btn = ""
# input_player1_r2_btn = ""
# input_player1_l3_btn = ""
# input_player1_r3_btn = ""

# Menu buttons.
# menu_search_btn      = ""
# menu_info_btn        = ""
# menu_default_btn     = ""
# menu_scroll_down_btn = ""
# menu_scroll_up_btn   = ""

# Swap the button assignments for OK and Cancel.
# menu_swap_ok_cancel_buttons = "false"

# Swap the scrolling mode button assignments; 10 item blocks vs. by letter.
# menu_swap_scroll_buttons = "false"

# RetroArch D-Pad axes, must have '+' or '-' as the first character, to
# indicate the direction, followed by the axis number.
# input_player1_left_axis = ""
# input_player1_right_axis = ""
# input_player1_up_axis = ""
# input_player1_down_axis = ""

# Turbo button assignment. Holding turbo while pressing another button places
# that button into turbo mode where its state is modulated with a periodic
# signal which ceases upon its release.
# input_player1_turbo = ""

# Turbo mode signal period and duration; values are in frames.
# input_turbo_period = "6"
# input_turbo_duty_cycle = "3"

# This goes all the way to user 16 (*_player2_*, *_player3_*, etc.), when
# required. All input binds have counterparts for keyboard (none), joypad
# buttons (_btn) and axes (_axis) as well.

# Fullscreen toggle button assignment.
input_toggle_fullscreen = "f"

# Save state.
input_save_state = "f2"
# Load state.
input_load_state = "f4"

# State slot cycling button assignment. For slot 0, save state name is *.state
# (or whatever is defined on the command line). For other slots, the path will
# be $path%d, where %d is the slot number.
input_state_slot_decrease = "f6"
input_state_slot_increase = "f7"

# Input assignment for toggling between fast-forward and normal mode.
input_toggle_fast_forward = "space"

# Fast-forward input button assignment; only lasts while button is depressed.
input_hold_fast_forward = "l"

# Input key to exit RetroArch cleanly; killing it in any hard way like SIGKILL,
# et al., will terminate RetroArch without saving RAM, etc. On *nix-likes, SIGINT/SIGTERM are used for a clean deinitialization.
# input_exit_emulator = "escape"

# Apply previous/next shader in directory.
input_shader_next = "m"
input_shader_prev = "n"
input_shader_toggle = "comma"

# Input button mapping for gameplay rewinding; feature must be enabled as well.
# input_rewind = "r"

# Input button mapping for toggling the gameplay recording feature on/off.
# input_movie_record_toggle = "o"

# Input button mapping to toggle between paused and unpaused state.
input_pause_toggle = "p"

# Frame advance input mapping, only works when content is paused.
# input_frame_advance = "k"

# Input mapping to reinitialize the loaded content.
# input_reset = "h"

# Input mappings for navigating the cheat index.
# input_cheat_index_minus = "t"
# input_cheat_index_plus = "y"
# input_cheat_toggle = "u"

# Input mapping to mute/unmute audio output.
input_audio_mute = "f9"

# Input mapping to trigger a screenshot capture.
input_screenshot = "f8"

# Input mapping to trigger flipping users during Netplay.
# input_netplay_flip_players = "i"

# Hold for slow-motion.
#input_slowmotion = e

# Toggle sync to exact content framerate.
# input_toggle_vrr_runloop = "nul"

# Enable other hotkeys; if this hotkey is bound to either keyboard, joybutton or
# joyaxis, all other hotkeys will be disabled unless this hotkey is also held at
# the same time. This is useful for RETRO_KEYBOARD-centric implementations which
# query a large area of the keyboard, where it is not desirable that hotkeys get
# in the way. Alternatively, all hotkeys for keyboard could be disabled by the
# user.
# input_enable_hotkey_btn = "nul"

# Add a delay in frames before the assigned hotkey blocks input; useful if the
# hotkey input is mapped to another action.
#input_hotkey_block_delay = "5"

# Increases audio volume.
input_volume_up = "add"
# Decreases audio volume.
input_volume_down = "subtract"

# Toggle to the next overlay; wrapping at the end.
#input_overlay_next = "nul"

# Toggle eject for disks, used for multiple-disk content.
#input_disk_eject_toggle = "nul"

# Cycle through disk images, used after ejecting; complete by toggling eject
# again.
#input_disk_next = "nul"

# Toggle menu.
input_menu_toggle = "f1"

# Toggle display of on-screen technical statistics.
#input_toggle_statistics = "nul"

# RetroPad button combination to toggle menu.
#   0: None
#   1: Down + Y + L1 + R1
#   2: L3 + R3
#   3: L1 + R1 + Start + Select
#   4: Start + Select
#   5: L3 + R1
#   6: L1 + R1
#   7: Hold Start (2 seconds)
#   8: Hold Select (2 seconds)
#   9: Down + Select
#  10: L2 + R2
input_menu_toggle_gamepad_combo = "0"

# RetroPad button combination to quit.
#   0: None
#   1: Down + Y + L1 + R1
#   2: L3 + R3
#   3: L1 + R1 + Start + Select
#   4: Start + Select
#   5: L3 + R1
#   6: L1 + R1
#   7: Hold Start (2 seconds)
#   8: Hold Select (2 seconds)
#   9: Down + Select
#  10: L2 + R2
input_quit_gamepad_combo = "0"

# Allow any RetroPad to control the menu?
#all_users_control_menu = "false"

# Toggle mouse grab. When mouse is grabbed, RetroArch hides the mouse and keeps
# the mouse pointer inside the window to allow relative mouse input to work
# better.
input_grab_mouse_toggle = "f11"

#### Menu

# Show 'Online Updater' inside the menu?
menu_show_online_updater = "true"

# Show the ability to update cores (and core info files) inside the menu?
menu_show_core_updater = "false"

# Allow libretro core to keep running in the background when navigating the
# menu?
menu_pause_libretro = "true"

# Use separate controls for menu operation?
menu_unified_controls = "false"

# Enable mouse controls inside the menu.
menu_mouse_enable = "true"

# Enable touch controls inside the menu.
menu_pointer_enable = "false"

# Show current date and/or time inside menu.
menu_timedate_enable = "true"

# Show current battery level inside menu.
menu_battery_level_enable = "false"

# Show active gaming core inside menu?
menu_core_enable = "true"

# Path to menu wallpaper image.
#menu_wallpaper = ""

# Dynamically load a new wallpaper depending on context?
menu_dynamic_wallpaper_enable = "true"

# Type of thumbnail to display: 0 = none, 1 = snaps, 2 = titles, 3 = boxarts.
menu_thumbnails = "3"
menu_left_thumbnails = "2"

# Wrap-around to beginning/end if boundary of list is reached horizontally or
# vertically?
menu_navigation_wraparound_enable = "true"

# Filter files being shown in filebrowser by supported extensions.
menu_navigation_browser_filter_supported_extensions_enable = "true"

# Collapse subgroup settings into main group to create one big list of settings
# per category.
#menu_collapse_subgroups_enable = false

#### Core

# Prevent libretro cores from closing RetroArch on exit by loading a dummy core.
load_dummy_on_core_shutdown = "true"

# Check for firmware requirement(s) before loading a content.
check_firmware_before_loading = "true"

#### User Interface

# Start UI companion driver's interface on boot (if available).
ui_companion_start_on_boot  = "true"

# Toggle companion UI on startup (currently only used to show the WIMP UI)
ui_companion_toggle = "false"

# Only init the WIMP UI for this session if this is enabled
desktop_menu_enable = "true"

#### Camera

# Override the default camera device the camera driver uses; this is driver-
# dependant.
#camera_device =

# Override the default privacy permission for cores that want to access camera
# services; "false" by default.
camera_allow = "false"

#### Location

# Override the default privacy permission for cores that want to access location
# services; "false" by default.
location_allow = "false"

#### Core Updater

# URL to core update directory on buildbot.
#core_updater_buildbot_url = "http://buildbot.libretro.com"

# URL to assets update directory on buildbot.
#core_updater_buildbot_assets_url = "http://buildbot.libretro.com/assets/"

# After downloading, automatically extract downloaded archives.
#core_updater_auto_extract_archive = true

#### Network

# When being client over netplay, use keybinds for user 1.
#netplay_client_swap_input = false

# The username of the person running RetroArch; this will be used for playing
# online, for instance.
#netplay_nickname =

# The amount of delay frames to use for netplay; increasing this value will
# increase performance at the cost of more latency.
#netplay_delay_frames = 0

# Netplay mode for the current user; false is Server, true is Client.
#netplay_mode = false

# Spectator mode for the user during netplay.
#netplay_spectator_mode_enable = false

# IP Address of the netplay host to connect to.
#netplay_ip_address =

# The port of the netplay host, can be either TCP or UDP.
#netplay_ip_port = 55435

# Force game hosting to go through a man-in-the-middle server, to get around
# firewalls and NAT/UPnP problems.
#netplay_use_mitm_server = false

# The requested MITM server to use.
#netplay_mitm_server = "nyc"

#### Directory

# Set the System/BIOS directory; implementations can query this directory to
# load BIOSes, system-specific configs, etc.
system_directory = "~/.local/share/retroarch/system"

# Save all downloaded files to this directory.
core_assets_directory = "~/.local/share/retroarch/downloads"

# Assets directory; this location is queried by default when menu interfaces try
# to look for loadable assets, etc.
assets_directory = "/usr/share/libretro/assets/"

# Dynamic wallpapers directory, the place to store the wallpapers dynamically
# loaded by the menu, depending on context.
dynamic_wallpapers_directory = "default"

# Thumbnails directory.
thumbnails_directory = "~/.local/share/retroarch/thumbnails"

# File browser directory, sets initial directory for in-app file browser.
rgui_browser_directory = "/"

# Core directory for libretro core implementations.
libretro_directory = "/usr/lib/@DEB_HOST_MULTIARCH@/libretro/"

# Core info directory for libretro core information.
libretro_info_path = "/usr/share/libretro/info/"

# Path to content database directory.
content_database_path = "~/.local/share/retroarch/rdb"

# Path to cheat database directory.
cheat_database_path = "~/.local/share/retroarch/cheats"

# Define directory where CPU-based video filters are kept.
video_filter_dir = "/usr/lib/@DEB_HOST_MULTIARCH@/retroarch/filters/video/"

# Directory where DSP plugins are kept.
audio_filter_dir = "/usr/lib/@DEB_HOST_MULTIARCH@/retroarch/filters/audio/"

# Define a directory where shaders (Cg, CGP, GLSL) are kept for easy access.
video_shader_dir = "~/.local/share/retroarch/shaders"

# Recording output directory.
recording_output_directory = "~/Videos/RetroArch"

# Recording configuration directory.
recording_config_directory = "~/.config/retroarch/recording"

# Overlay directory.
overlay_directory = "~/.local/share/retroarch/overlays"

# Directory to dump screenshots to.
screenshot_directory = "~/Pictures/RetroArch/screenshots"

# Directory for joypad autoconfigs. If a joypad is plugged in, that joypad will
# be autoconfigured if a config file corresponding to that joypad is present
# here. Input binds which are made explicitly (input_playerN_*_btn/axis) will
# take priority over autoconfigs. Autoconfigs can be created manually or using
# the menu; requires input_autodetect_enable to be enabled.
joypad_autoconfig_dir = "~/.config/retroarch/autoconfig"

# Save all remapped controls to this directory.
input_remapping_directory = "~/.config/retroarch/remaps"

# Save all playlists/collections to this directory.
playlist_directory = "~/.local/share/retroarch/plists"

# Save all save files (*.srm) to this directory, including related files like
# .bsv, .rtc, .psrm, etc. This will can be overridden by command line options.
savefile_directory = "~/.local/share/retroarch/saves"

# Save all save states (*.state) to this directory; can be overridden by command
# line options.
savestate_directory = "~/.local/state/retroarch/saves"

# If set to a directory, content which is temporarily extracted will be placed
# here.
cache_directory = "~/.cache/retroarch"

#### RetroAchievements

# Enable the RetroAchievements feature.
#cheevos_enable = false

# RetroAchievements.org credentials.
#cheevos_username =
#cheevos_password =

# Show a popup when logging in to RetroAchievements.
#cheevos_visibility_account = true

# The hardcore mode disables savestates and cheating features. Achievements
# earned in hardcore mode are uniquely marked so that you can show others what
# you've achieved without emulator assistance features.
#cheevos_hardcore_mode_enable = true

# Show a popup when an achievement is unlocked.
#cheevos_visibility_unlock = true

# Play the 'unlock' audio sound when an achievement is unlocked.
#cheevos_unlock_sound_enable = false

# Take a screenshot when an achievement is triggered.
#cheevos_auto_screenshot = false

# Show a popup when all achievements for a game are unlocked.
#cheevos_visibility_mastery = true

# Shows additional diagnostic and error messages
#cheevos_verbose_enable = false

# Show achievements' badges in Quick Menu > Achievements List. (Note: This has
# no effect if menu_driver = rgui).
#cheevos_badges_enable = false

# Show an on-screen indicator when attempting challenging achievements, to
# provide feedback when the attempt has failed (for achievements that support
# it).
#cheevos_challenge_indicators = true

# Show a message when a leaderboard activates.
#cheevos_visibility_lboard_start = true

# Show a message with your score when a leaderboard is submitted to the server.
#cheevos_visibility_lboard_submit = true

# Show an on-screen tracker with the current value of active leaderboards.
#cheevos_visibility_lboard_trackers = true

# Send some messages to the RetroAchievements.org saying, for example, where you
# are in the game, how many lives you have, your score, etc.
#cheevos_richpresence_enable = true

# Even after unlocking achievements in previous sessions, you may still want to
# see them triggering in the current session. (encore mode)
#cheevos_start_active = false

# Unofficial achievements are used only for achievement creators and testers.
#cheevos_test_unofficial = false

#### Misc

# Enable rewinding; this incurs a performance hit when playing, so it is
# disabled by default.
#rewind_enable = false

# Rewinding buffer size, in megabytes; a larger rewinding buffer means you can
# rewind longer. The buffer should be ~20MiB/minute of buffer time.
#rewind_buffer_size = 20

# Rewind granularity. When rewinding defined number of frames, you can rewind
# several frames at a time, increasing the rewinding speed.
#rewind_granularity = 1

# Pause gameplay when window focus is lost.
#pause_nonactive = true

# Pause gameplay when controller disconnects.
#pause_on_disconnect = true

# Autosave non-volatile SRAM at a regular interval; this is disabled by default.
# The interval is measured in seconds with a value of 0 meaning disable.
#autosave_interval =

# Record video after CPU video filter.
#video_post_filter_record = false

# Record output of GPU shaded material, if available.
#video_gpu_record = false

# Screenshots output of GPU shaded material, if available.
#video_gpu_screenshot = true

# Watch content shader files for changes and auto-apply as necessary?
#video_shader_watch_files = false

# Block SRAM from being overwritten when loading save states; might potentially
# lead to buggy games.
#block_sram_overwrite = false

# When saving a save state, index is automatically increased before it is saved.
# Also, when loading content, the index will be set to the highest existing
# index. There is no upper bound on the index.
#savestate_auto_index = false

# Slowmotion ratio. When slowmotion, content will slow down by factor.
#slowmotion_ratio = 3.0

# The maximum rate at which content will be run when using fast forward (e.g.
# 5.0 for 60 fps content => 300 fps cap). RetroArch will go to sleep to ensure
# that the maximum rate will not be exceeded; do not rely on this cap to be
# perfectly accurate. If set to 0, then fastforward ratio is unlimited.
#fastforward_ratio = 0.0

# Enable stdin/network command interface.
#network_cmd_enable = false
#network_cmd_port = 55355
#stdin_cmd_enable = false

# Enable Sustained Performance Mode in Android 7.0+
#sustained_performance_mode = true

# File format to use when writing playlists to disk
#playlist_use_old_format = false

# Keep track of how long each core+content has been running for over time.
#content_runtime_log = false

#vibrate_on_keypress = false

# Enable device vibration for supported cores.
#enable_device_vibration = false

# Enable game mode on supported platforms. Depending on the system, it can
# result in more stable frame times, less audio crackling, better performance
# and lower latency. On Linux, Feral GameMode needs to be installed
# <https://github.com/FeralInteractive/gamemode>.
#gamemode_enable = true
