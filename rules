#!/usr/bin/make -f
# -*- mode: makefile-gmake; coding: utf-8 -*-
# SPDX-FileCopyrightText: © 2012-2025, Hunter Kaller <hunter_kaller@yahoo.com>
# SPDX-FileCopyrightText: © 2014-2018, Sergio Benjamim <sergio_br2@yahoo.com.br>
# SPDX-FileCopyrightText: © 2020-2025, Paul Preuss <paul@dokomi.de>
# SPDX-FileCopyrightText: © 2021-2025, Peter J. Mello <admin@petermello.net>
#
# SPDX-License-Identifier: GPL-3.0-or-later OR MPL-2.0

SHELL                        ::= $(realpath /bin/bash)
MAKEFLAGS                     += --output-sync=target

# Fix hardening-no-bindnow and hardening-no-pie
DEB_BUILD_MAINT_OPTIONS      ::= future=+lfs hardening=+all,-fortify \
									optimize=+lto reproducible=+fixfilepath
DEB_CFLAGS_MAINT_APPEND      ::= -DLUA_USE_POSIX -O3
DEB_CFLAGS_MAINT_STRIP       ::= -O2
DEB_CXXFLAGS_MAINT_APPEND    ::= -DLUA_USE_POSIX -O3
DEB_CXXFLAGS_MAINT_STRIP     ::= -O2
DEB_LDFLAGS_MAINT_APPEND     ::= -lGL -lpthread
DOXYGEN                      ::= $(realpath /bin/doxygen)
DPKG_EXPORT_BUILDFLAGS       ::= 1
DPKG_EXPORT_BUILDTOOLS       ::= 1
INSTALL_d                    ::= $(realpath /bin/install) -vd
LTO                          ::= 1
MAKE_ARGS                    ::= "QT_VERSION=qt6"
MOC                          ::= /usr/lib/qt6/libexec/moc
QT_SELECT                    ::= qt6

ifeq (,$(findstring terse,$(DEB_BUILD_OPTIONS)))
  DH_VERBOSE                 ::= 1
  MAKE_ARGS                   += "V=1"
  export DH_VERBOSE
endif

# Use Bash's built-in printf to pass the Ubuntu version when the dpkg flag set
# was introduced, and compare it to the version of the build system (host) by
# supplying them on separate lines to 'sort' with greatest first ordering, then
# pipe to 'head' to isolate the larger value. If the output matches the build
# system (i.e. it's ≥the version of introduction), then set the flags.
uver ::= $(shell lsb_release -rs | cut -c-5)
include /usr/share/dpkg/vendor.mk
ifeq (Ubuntu,$(DEB_VENDOR))
  # Add C preprocessor definitions for Large File Support and time64.
  ifeq ($(uver),$(shell printf "$(uver)\n23.10\n" | sort -gr | head -1))
    DEB_BUILD_MAINT_OPTIONS   += abi=+all
  endif

  # Pass ELF package metadata to linker for easier debugging by users.
  ifeq ($(uver),$(shell printf "$(uver)\n24.10\n" | sort -gr | head -1))
    DEB_BUILD_MAINT_OPTIONS   += qa=-bug-implicit-func,+elfpackagemetadata
    DEB_BUILD_DEBUG_INFO_URL ::= https://debuginfod.ubuntu.com/
    export DEB_BUILD_DEBUG_INFO_URL
  else
    DEB_BUILD_MAINT_OPTIONS   += qa=-bug-implicit-func
  endif
endif

include /usr/share/dpkg/default.mk

dv       ::= $(DEB_VERSION)
pcfilesd ::= $(CURDIR)/debian/pkgconf
usrgames ::= $(CURDIR)/debian/retroarch/usr/games
usrshare ::= $(CURDIR)/debian/retroarch/usr/share
GIT_HASH ::= $(shell echo '$(dv)' | sed -Ene 's/.*~([0-9a-f]{7,10})-\d*.*/\1/p')

# See ./configure --help for valid flags for the QuickBuild framework
QB_BUILD_FLAGS ::= --prefix=/usr --bindir=/usr/games --datarootdir=/usr/share \
	--docdir=/usr/share/doc/retroarch --mandir=/usr/share/man \
	--sysconfdir=/etc --build=$(DEB_BUILD_GNU_TYPE) \
	--with-assets_dir=/usr/share/libretro \
	--with-filters_dir=/usr/lib/$(DEB_HOST_MULTIARCH)/retroarch \
	--with-core_info_dir=/usr/share/libretro
QB_LIBS_FLAGS  ::= --enable-al --enable-alsa --disable-audioio \
	--enable-blissbox --enable-bluetooth --disable-builtinbearssl \
	--enable-builtinflac --disable-builtinglslang --disable-builtinmbedtls \
	--disable-builtinzlib --enable-caca --enable-cdrom --enable-check \
	--enable-command --disable-core_info_cache --disable-coreaudio \
	--disable-d3d9 --disable-d3dx --enable-dbus --disable-dinput \
	--enable-dr_mp3 --disable-dsound --enable-dylib --disable-dynamic_egl \
	--enable-egl --enable-ffmpeg --enable-flac --enable-freetype \
	--enable-game_ai --disable-gdi --enable-glslang --enable-hid --enable-jack \
	--enable-kms --enable-libdecor --enable-libshake --enable-libusb \
	--enable-lua --enable-materialui --enable-memfd_create --enable-mmap \
	--disable-mpv --enable-network_video --enable-networkgamepad \
	--enable-networking --disable-nvda --enable-opengl --disable-osmesa \
	--disable-oss --enable-ozone --enable-parport --enable-pipewire \
	--enable-plain_drm --enable-pulse --enable-qt --enable-rgui --disable-roar \
	--disable-rsound --disable-sdl --enable-sdl2 --enable-sixel --enable-slang \
	--enable-spirv_cross --enable-ssa --enable-ssl --enable-systemd \
	--enable-systemmbedtls --enable-threads --enable-thread_storage \
	--disable-tinyalsa --enable-udev --enable-v4l2 --disable-vg \
	--disable-videocore --enable-videoprocessor --enable-vulkan \
	--disable-wasapi --enable-wayland --enable-wifi --disable-winmm \
	--disable-winrawinput --enable-x11 --disable-xaudio --enable-xdelta \
	--enable-xi2 --enable-xinerama --enable-xmb --enable-xrandr \
	--enable-xscrnsaver --enable-xshm --enable-xvideo --enable-zlib \
	--enable-zstd

ifeq ($(DEB_HOST_GNU_CPU),$(filter $(DEB_HOST_GNU_CPU),x86_64 i386))
  QB_LIBS_FLAGS += --enable-cg --disable-opengles --disable-rpiled --enable-sse
else ifeq ($(DEB_HOST_GNU_CPU),aarch64)
  QB_LIBS_FLAGS += --disable-cg --enable-opengles --enable-opengles3 \
					--enable-opengles3_1 --enable-opengles3_2
else ifeq ($(DEB_HOST_ARCH),armhf)
  QB_LIBS_FLAGS += --disable-cg --enable-floathard --enable-neon \
					--enable-opengles --enable-opengles3 --enable-opengles3_1 \
					--enable-opengles3_2 --enable-sunxi
else ifeq ($(DEB_HOST_ARCH),armel)
  QB_LIBS_FLAGS += --disable-cg --enable-floatsoftfp --enable-opengles \
					--enable-opengles3 --enable-opengles3_1 --enable-opengles3_2
else
  QB_LIBS_FLAGS += --disable-cg --disable-opengles
endif

ifneq ($(GIT_HASH),)
  GIT_VERSION  ::= $(GIT_HASH)
  MAKE_ARGS     += "GIT_VERSION='$(GIT_HASH)'"
  export GIT_VERSION
endif

# GLSL v14.0.0 dropped legacy stub libraries libIGLCompiler and libHLSL and a
# patch was added to the series to remove them from QuickBuild. This conditional
# tests if we are using such a GLSL, and if not, adds back the linker flags for
# both libraries as arguments to the $(MAKE) invocation. Drop this once builds
# are no longer needed for Ubuntu 23.10 "Mantic Minotaur" and its predecessors.
glsl_v   ::= $(shell dpkg-query -f '$${Version}' -W glslang-dev)
glsltest ::= $(shell dpkg --compare-versions $(glsl_v) ge 14.0.0 && echo "true")
ifneq ($(glsltest),true)
  MAKE_ARGS     += GLSLANG_LIBS+="-lglslang -lOGLCompiler -lHLSL"
endif

export DEB_BUILD_MAINT_OPTIONS DEB_CFLAGS_MAINT_APPEND DEB_CFLAGS_MAINT_STRIP \
		DEB_CXXFLAGS_MAINT_APPEND DEB_CXXFLAGS_MAINT_STRIP \
		DEB_LDFLAGS_MAINT_APPEND DOXYGEN LTO MOC QT_SELECT SHELL


%:
	dh $@ -v -Smakefile --without autoreconf,autotools-dev


execute_before_dh_auto_clean:
	touch "$(CURDIR)/config.mk"

execute_after_dh_auto_clean:
	dh_auto_clean -O-v -O-Smakefile -O-Dgfx/video_filters
	dh_auto_clean -O-v -O-Smakefile -O-Dlibretro-common/audio/dsp_filters

execute_before_dh_auto_configure-arch:
	LC_ALL=C.UTF-8 sed -e 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' \
		"$(CURDIR)/retroarch.cfg" >"$(CURDIR)/debian/retroarch.cfg"
ifeq ($(uver),22.04)
	# The qt6-base-dev package in the Ubuntu 22.04 package repositories fails
	# to install the pkgconf files for the Qt6 libraries, and since Quickbuild
	# lacks the versatility to fallback to the CMake config files it /does/
	# install, the .pc files must be instantiated here at build time.
	@$(INSTALL_d) "$(pcfilesd)"
	set -e; for pcfile in Concurrent Core Gui Network Platform Widgets; do \
		test -e /usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig/Qt6$${pcfile}.pc || \
		LC_ALL=C.UTF-8 sed -e 's/@DEB_HOST_MULTIARCH@/$(DEB_HOST_MULTIARCH)/g' \
			"$(pcfilesd).in/Qt6$${pcfile}.pc.in" \
				>"$(pcfilesd)/Qt6$${pcfile}.pc"; done
endif

override_dh_auto_configure-arch:
	PKG_CONFIG_PATH="$(pcfilesd)$${PKG_CONFIG_PATH:+:$$PKG_CONFIG_PATH}" \
		QT_VERSION="$(QT_SELECT)" MOC="$(MOC)" $(CURDIR)/configure \
			$(QB_BUILD_FLAGS) $(QB_LIBS_FLAGS)

# Nothing to do here, we handle the Doxygen configuration with a quilt patch.
override_dh_auto_configure-indep:

override_dh_auto_build-arch: | BUILDretroarch BUILDsoft_filters BUILDdsp_plugins

BUILDretroarch:
	$(info Building Retroarch…)
	dh_auto_build -O-v -O-Smakefile -- $(MAKE_ARGS)

BUILDsoft_filters:
	$(info Building Video SoftFilters…)
	dh_auto_build -O-v -O-Smakefile -O-Dgfx/video_filters -- $(MAKE_ARGS)

BUILDdsp_plugins:
	$(info Building Audio DSP plugins…)
	dh_auto_build -O-v -O-Smakefile -O-Dlibretro-common/audio/dsp_filters -- \
		$(MAKE_ARGS)

override_dh_auto_build-indep:
ifeq (,$(findstring nodoc,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
	$(info Building Doxygen developer documentation…)
	$(DOXYGEN) "$(CURDIR)/Doxyfile"
endif

# Noop the entire upstream installation routine, only use debhelper routines.
override_dh_auto_install-arch:

override_dh_auto_install-indep:
	@$(INSTALL_d) "$(CURDIR)/debian/tmp/usr/share/doc/libretro-api"
	@cp -Rvfa "$(CURDIR)/doxygen/html" \
		"$(CURDIR)/debian/tmp/usr/share/doc/libretro-api"

execute_after_dh_install-arch:
	chrpath -d "$(CURDIR)/debian/retroarch/usr/games/retroarch"
	@cp -vfa "$(CURDIR)/tools/cg2glsl.py" "$(usrgames)/retroarch-cg2glsl"
	@chmod -v 0755 "$(usrgames)/retroarch-cg2glsl"

override_dh_installdocs-indep:
	dh_installdocs -O-v -plibretro-dev-doc --doc-main-package=retroarch-dev
	dh_installdocs -O-v --indep --remaining-packages

override_dh_doxygen:
ifeq (,$(findstring nodoc,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)))
	dh_doxygen -plibretro-dev-doc
endif

execute_after_dh_link-indep:
	jdupes -rl "$(CURDIR)/debian/libretro-dev-doc/usr"

override_dh_shlibdeps:
	dh_shlibdeps -O-v -l/lib/$(DEB_HOST_MULTIARCH)

.NOTPARALLEL: override_dh_auto_build-arch
.PHONY: execute_after_dh_auto_clean execute_after_dh_install-arch \
		execute_after_dh_link-indep execute_before_dh_auto_clean \
		execute_before_dh_auto_configure-arch override_dh_auto_build-arch \
		override_dh_auto_build-indep override_dh_auto_configure-arch \
		override_dh_auto_install-arch override_dh_auto_install-indep \
		override_dh_doxygen override_dh_installdocs-indep override_dh_shlibdeps
